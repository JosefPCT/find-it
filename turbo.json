{
  "$schema": "./node_modules/turbo/schema.json",
  "globalEnv": ["DATABASE_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^db:generate", "^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "dependsOn": ["^db:generate"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "cache": false,
    },
    "db:generate": { 
      "cache": false
    }, 
    "db:migrate": { 
      "cache": false,
    }, 
    "db:deploy": { 
      "cache": false
    },
    "db:seed": {
      "cache": false,
      "persistent": false
    },
    "db:reset": {
      "cache": false,
    },
    "start":{
      "dependsOn": ["db:deploy"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    }
  },

}
