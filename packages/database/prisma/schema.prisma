// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Image {
  id             Int     @id @default(autoincrement())
  publicId       String  @unique @default(uuid()) @map("public_id") @db.Uuid
  name           String
  url            String
  OriginalWidth  Int     @map("original_width")
  OriginalHeight Int     @map("original_height")
  additionalInfo String? @map("additional_info")
  tags           Tag[]
  scores         Score[]

  @@map("images")
}

model Tag {
  id          Int    @id @default(autoincrement())
  imageId     Int    @map("image_id")
  parentImage Image  @relation(fields: [imageId], references: [id])
  publicId    String @unique @default(uuid()) @map("public_id") @db.Uuid
  name        String
  x           Int
  y           Int

  @@map("tags")
}

model Score {
  id        Int       @id @default(autoincrement())
  pubicId   String    @unique @default(uuid()) @map("public_id") @db.Uuid
  image     Image?    @relation(fields: [imageId], references: [id])
  imageId   Int?
  name      String    @default("Anonymous")
  startTime DateTime  @default(now()) @db.Timestamptz(6)
  endTime   DateTime? @db.Timestamptz(6)
  finalTime Decimal?  @db.Decimal(5, 2)

  @@map("scores")
}
